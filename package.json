{
  "name": "todo-explorer",
  "displayName": "TODO Explorer",
  "description": "A VS Code extension that finds TODO and FIXME comments in source files, groups them by file, and displays them in a sidebar for easy navigation.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "todo-explorer.refresh",
        "title": "Сканировать проект",
        "category": "TODO Explorer",
        "icon": "$(search)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "todoExplorer",
          "title": "TODO Explorer",
          "icon": "resources/todo.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "todoExplorer.tasks",
        "contents": "Проект ещё не сканировался.\n[Сканировать проект](command:todo-explorer.refresh)",
        "when": "todoExplorer.scanState == unscanned"
      },
      {
        "view": "todoExplorer.tasks",
        "contents": "В проекте не найдено комментариев TODO или FIXME.\n[Сканировать снова](command:todo-explorer.refresh)",
        "when": "todoExplorer.scanState == empty"
      }
    ],
    "views": {
      "todoExplorer": [
        {
          "id": "todoExplorer.tasks",
          "name": "Tasks",
          "icon": "resources/todo.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "todo-explorer.refresh",
          "when": "view == todoExplorer.tasks",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scp252arc/todo-explorer.git"
  }
}
